{
  "name": "fe",
  "version": "0.1.0",
  "description": "Open Panda frontend",
  "main": "index.js",
  "scripts": {
    "dev": "../../node_modules/.bin/nuxt",
    "start": "../../node_modules/.bin/nuxt start",
