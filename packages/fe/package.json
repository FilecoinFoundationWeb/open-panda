    "@nuxtjs/axios": "^5.13.6",
    "@nuxtjs/eslint-config": "^10.0.0",
    "@nuxtjs/eslint-module": "^3.0.2",
    "@nuxtjs/moment": "^1.6.1",
    "@nuxtjs/storybook": "^4.3.2",
    "@nuxtjs/style-resources": "^1.2.1",
    "@nuxtjs/gtm": "^2.4.0",
    "core-js": "^3.27.1",
    "country-code-emoji": "^2.3.0",
    "eslint": "^8.3.0",
